<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="dev.podcast.nativeapp.SEARCH"
            android:targetClass="dev.podcast.nativeapp.MainActivity"
            android:targetPackage="dev.podcast.nativeapp" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_latest"
        android:shortcutId="latest_episode"
        android:shortcutLongLabel="@string/shortcut_latest_episode"
        android:shortcutShortLabel="@string/shortcut_latest_episode">
        <intent
            android:action="dev.podcast.nativeapp.LATEST_EPISODE"
            android:targetClass="dev.podcast.nativeapp.MainActivity"
            android:targetPackage="dev.podcast.nativeapp" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_recent"
        android:shortcutId="recently_played"
        android:shortcutLongLabel="@string/shortcut_recently_played"
        android:shortcutShortLabel="@string/shortcut_recently_played">
        <intent
            android:action="dev.podcast.nativeapp.RECENTLY_PLAYED"
            android:targetClass="dev.podcast.nativeapp.MainActivity"
            android:targetPackage="dev.podcast.nativeapp" />
    </shortcut>
</shortcuts>
